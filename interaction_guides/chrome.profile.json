{
  "key": "chrome",
  "display": "Google Chrome",
  "version": 3,
  "trigger": {
    "process": [
      "chrome.exe"
    ],
    "also_matches": [
      "google chrome",
      "chromium"
    ]
  },
  "states": [
    {
      "id": "browser",
      "detect": {
        "uia_any": [
          {
            "name": "Google Chrome"
          }
        ]
      },
      "text": "Chrome browser window (browser chrome only; page content ignored). Tab strip y~0-40 (tab-search ~20, tabs, + ~530, min/max/close 1804/1851/1896). Toolbar y~44-86: back 22, forward 59, reload 95, omnibox pill x121-1744 (site-info 132, bookmark star 1721), extension buttons 1771/1807, avatar 1858, 3-dot menu 1897. Nav buttons act on the ACTIVE tab only. Menus/bubbles are separate Chrome_WidgetWin_1 popups (tool_window/no_activate/topmost, owner=main): read labels with win_read_text(popup_hwnd); Esc closes.",
      "controls": {
        "tab_search": {
          "match": {
            "click": [
              20,
              19
            ]
          }
        },
        "new_tab_button": {
          "match": {
            "click": [
              530,
              20
            ]
          }
        },
